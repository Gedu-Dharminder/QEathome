@model GuidePageViewModel
@* QE@@Home: contacts section. Edit content here; layout, navigation and footer are in Views/Shared/_QEatHomeLayout.cshtml. *@
  <div class="hero"><div class="hero-img" style="background-image:url(/qe-at-home/img/reception.jpg);background-position:55% 62%"></div>
    <div class="in"><div class="kicker">Section 9</div><h1>Partnership and Communication</h1></div>
  </div>
  <section class="block">
    <div class="wrap grid2">
      <div>
        <h2>Roles and Responsibilities</h2>
        <div class="tbl"><table style="min-width:0">
          <tr><th>Who</th><th>Responsibility</th></tr>
          <tr><td class="k">Senior leaders</td><td>Oversee quality, access, safeguarding and communication</td></tr>
          <tr><td class="k">Teachers</td><td>Clear instruction, structured learning and regular feedback</td></tr>
          <tr><td class="k">Inclusion team</td><td>Adjustments and wellbeing support</td></tr>
          <tr><td class="k">Safeguarding Lead</td><td>Ensure online safeguarding procedures are active and monitored</td></tr>
          <tr><td class="k">Parents and carers</td><td>Support routines, supervision and communication</td></tr>
          <tr><td class="k">Students</td><td>Attend sessions, submit work and follow behaviour expectations</td></tr>
        </table></div>
      </div>
      <div>
        <h2>Attendance and Engagement</h2>
        <p>Registers are taken in live lessons, and we keep engagement records throughout. We follow up non-engagement daily, just as we would in school, and any teacher with a concern about attendance, engagement or welfare will contact your child’s tutor or class teacher.</p>
        <p>If your child is unwell and cannot take part, please let their class teacher or Personal Tutor know before the school day begins, as you would normally.</p>
        <h2 style="margin-top:1em">Staying in Touch</h2>
        <ul class="tick">
          <li><strong>Pre-Prep:</strong> formal communication by email; daily learning and session links on Seesaw</li>
          <li><strong>Prep:</strong> formal communication by email; daily learning and updates on Seesaw</li>
          <li><strong>Senior School:</strong> Microsoft Teams, including year group updates, and email</li>
        </ul>
        <p>Your first point of contact is always your child’s class teacher (Pre-Prep and Prep) or Personal Tutor (Senior School).</p>
      </div>
    </div>
  </section>
