@model GuidePageViewModel
@* QE@@Home: prep section. Edit content here; layout, navigation and footer are in Views/Shared/_QEatHomeLayout.cshtml. *@
  <div class="hero"><div class="hero-img" style="background-image:url(/qe-at-home/img/teacher16.jpg);background-position:55% 50%"></div>
    <div class="in"><div class="kicker">Years 1 to 6</div><h1>Prep School</h1></div>
  </div>
  <section class="block">
    <div class="wrap">
      <div class="narrow center"><h2>The Prep Day</h2><p class="lead">Short live lessons with class teachers are followed by tasks completed offline, so that children learn actively without long periods in front of a screen. Specialist lessons continue throughout.</p></div>
      <div class="tbl" style="margin-top:28px"><table>
        <tr><th></th><th>Year 1</th><th>Years 2 to 6</th></tr>
        <tr><td class="k">Live lessons</td><td>English, Maths, Science and/or Concept, following the class timetable</td><td>English, Maths, Science and/or Concept, following the class timetable</td></tr>
        <tr><td class="k">Science and Concept</td><td>Each once a week</td><td>Concept once a week; Science twice a week (once a week in Year 2)</td></tr>
        <tr><td class="k">Live sessions per day</td><td>3 to 4</td><td>4</td></tr>
        <tr><td class="k">Length of live session</td><td>15 to 20 minutes with the class teacher</td><td>15 to 20 minutes with the class teacher</td></tr>
        <tr><td class="k">Specialist lessons</td><td>Continue, on rotation</td><td>Continue, on rotation</td></tr>
        <tr><td class="k">Offline learning</td><td>Project-based learning and NRICH tasks</td><td>Project-based learning and NRICH tasks</td></tr>
        <tr><td class="k">Community</td><td>Weekly assembly and a weekly session of The Good Morning Club</td><td>Weekly assembly and a weekly session of The Good Morning Club</td></tr>
      </table></div>
    </div>
  </section>
  <section class="block alt">
    <div class="wrap grid2">
      <div>
        <h2>How Lessons Work</h2>
        <p>Each live lesson is short and focused: the teacher introduces the learning, models it and checks understanding, before children move on to a task to complete offline.</p>
        <ul class="tick">
          <li><strong>Breakout rooms</strong> are used to adapt learning, so children who need extra support or more challenge receive it.</li>
          <li><strong>Familiar platforms</strong>, including The Good Morning Club, Times Tables Rock Stars and Spelling Shed, continue to support learning.</li>
          <li><strong>Specialist teachers</strong> provide lessons on a rotation, so the breadth of the curriculum continues.</li>
        </ul>
        <h2 style="margin-top:1.2em">Learning Beyond the Screen</h2>
        <p>Great learning is not confined to a screen. Each child will receive a bespoke QE Distance Learning Pack, designed for their year group, including:</p>
        <ul class="tick"><li>writing and grammar</li><li>comprehension and reading activities</li><li>handwriting and spelling</li><li>wellbeing journaling</li><li>conceptual tasks linked to thinking routines</li><li>mental maths, project-based learning and NRICH activities</li><li>optional projects</li></ul>
      </div>
      <div>
        <h2>Helping at Home</h2>
        <ul class="tick">
          <li>Keep to a consistent daily routine, using the timetable as your guide.</li>
          <li>Log your child on using their own Seesaw login. Teams links will be shared for live calls, and parents will need to log in on behalf of Prep students.</li>
          <li>Set up a suitable space in a shared area of the home, with the device charged and the pack to hand.</li>
          <li>Stay nearby for younger children, particularly Year 1.</li>
          <li>Tell your child’s class teacher promptly if something is not working.</li>
        </ul>
        <p>All formal communication will be by email. Learning activities, resources and updates for the day ahead will be on Seesaw; your child needs to be logged in with their own student login. A reduced QE Flourish offer runs in the afternoons, in 45-minute sessions.</p>
        <div class="callout">Questions? Contact your child’s class teacher, or <strong>Mrs Belle Wagner</strong>, Head of Prep, at <a href="mailto:bwagner@@qedubaisportscity.com" style="color:#fff">bwagner@@qedubaisportscity.com</a>.</div>
      </div>
    </div>
  </section>
